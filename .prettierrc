{
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "trailingComma": "all",
  "semi": true,
  "plugins": ["prettier-plugin-svelte", "@trivago/prettier-plugin-sort-imports"],
  "importOrder": ["^(react|svelte|svelte/.*|[a-z])", "^@", "^[./]"],
  "importOrderSeparation": false,
  "importOrderSortSpecifiers": true,
  "overrides": [
    {
      "files": ["*.svelte"],
      "options": { "parser": "svelte" }
    }
  ]
}
